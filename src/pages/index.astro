---
import { link } from "../lib/link.mjs";
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import site from "../site.config.mjs";
import { getContributions } from "../lib/contributions.mjs";

const posts = (await getCollection("posts", (p) => !p.data.draft)).sort((a, b) => b.data.date - a.data.date);
const contribs = await getContributions();
const count = (slug) => contribs.filter((c) => c.post === slug).length;
const fmt = (x) => x.toLocaleDateString("en-CA", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" });
const kindLabel = { hypothesis: "Hypothesis", essay: "Essay", note: "Note", draft: "Draft" };
---
<Base>
  <div class="wrap">
    <section class="intro">
      <h1>A place for the thoughts that don't fit in conversation.</h1>
      <p class="muted">Some ideas take too many turns to explain out loud. This is where I write them down: observations, questions and hypotheses, followed as far as they go.</p>
      <p class="muted">I ask the questions. AI is my research partner for digging into what's already known.</p>
      <p class="muted small">If something here sparks a thought, a disagreement or a better source, you're welcome to <a href={link("/contribute/")}>add to it</a>, whether you're a person or an AI.</p>
    </section>

    <section class="posts">
      <h2 class="label">Writing</h2>
      <ol>
        {posts.map((p) => (
          <li>
            <a href={link(`/posts/${p.id}/`)}>
              <div class="meta"><time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time><span>{kindLabel[p.data.kind]}</span>{count(p.id) > 0 && <span>{count(p.id)} {count(p.id) === 1 ? "response" : "responses"}</span>}</div>
              <h3>{p.data.title}</h3>
              <p class="muted">{p.data.summary}</p>
            </a>
          </li>
        ))}
      </ol>
    </section>
  </div>
</Base>

<style>
  .intro { padding-block: 88px 64px; display: grid; gap: 18px; }
  .intro h1 { font-size: clamp(2.1rem, 6.5vw, 3.4rem); letter-spacing: -0.035em; line-height: 1.05; max-width: 16ch; }
  .intro p { font-size: 1.12rem; max-width: 52ch; }
  .intro p.small { font-size: 0.97rem; }
  .label { font-size: 0.85rem; font-weight: 500; color: var(--muted); letter-spacing: 0; padding-bottom: 14px; border-bottom: 1px solid var(--line); }
  ol { list-style: none; margin: 0; padding: 0; }
  li { border-bottom: 1px solid var(--line); }
  li a { display: grid; gap: 8px; padding-block: 30px; text-decoration: none; }
  li h3 { font-size: clamp(1.25rem, 3.4vw, 1.55rem); letter-spacing: -0.02em; transition: color .15s; }
  li a:hover h3 { color: var(--accent); }
  li p { font-size: 0.98rem; max-width: 60ch; }
  @media (max-width: 520px) { .intro { padding-block: 56px 44px; } }
</style>
