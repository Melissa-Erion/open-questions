---
import { link, abs } from "../../lib/link.mjs";
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Contribution from "../../components/Contribution.astro";
import Cells from "../../components/Cells.astro";
import { contributionsFor, contributeUrl } from "../../lib/contributions.mjs";
import site from "../../site.config.mjs";

export async function getStaticPaths() {
  const posts = await getCollection("posts", (p) => !p.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const d = post.data;
const { Content, headings } = await render(post);
const contribs = await contributionsFor(post.id);
const fmt = (x) => x.toLocaleDateString("en-CA", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
const byClaim = (id) => contribs.filter((c) => c.claim === id).length;
const kindLabel = { hypothesis: "Hypothesis", essay: "Essay", note: "Note", draft: "Draft" }[d.kind];

const toc = [
  ...headings.filter((h) => h.depth === 2).map((h) => ({ id: h.slug, text: h.text })),
  ...(d.claims.length ? [{ id: "claims", text: "Claims" }] : []),
  ...(d.notClaimed.length ? [{ id: "not-claimed", text: "What this does not claim" }] : []),
  ...(d.references.length ? [{ id: "references", text: "References" }] : []),
  { id: "contributions", text: "Discussion" },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": d.kind === "hypothesis" ? "ScholarlyArticle" : "BlogPosting",
  headline: d.title,
  alternativeHeadline: d.subtitle,
  description: d.summary,
  datePublished: d.date.toISOString(),
  dateModified: (d.updated || d.date).toISOString(),
  version: d.version,
  author: site.author ? { "@type": "Person", name: site.author } : undefined,
  keywords: d.tags.join(", "),
  url: abs(`/posts/${post.id}/`),
  isAccessibleForFree: true,
  creativeWorkStatus: d.status,
};
---
<Base title={d.title} description={d.summary} jsonLd={jsonLd} alternateJson={`/posts/${post.id}.json`}>
  <div class:list={["head-band", { art: d.art }]}>
    {d.art === "cells" && <Cells fade="edge" />}
    <div class="layout">
      <header class="post-head">
        <div class="meta"><span>{kindLabel}</span><time datetime={d.date.toISOString()}>{fmt(d.date)}</time><span>Version {d.version}</span></div>
        <h1>{d.title}</h1>
        {d.subtitle && <p class="sub">{d.subtitle}</p>}
        {d.status && <p class="status"><strong>Status:</strong> {d.status}</p>}
      </header>
    </div>
  </div>

  <div class="layout body">
    <article class="post">
      <details class="toc-mobile">
        <summary>On this page</summary>
        <ol>{toc.map((t) => <li><a href={`#${t.id}`}>{t.text}</a></li>)}</ol>
      </details>

      <div class="prose"><Content /></div>

      {d.claims.length > 0 && (
        <section id="claims" class="block">
          <h2>Claims</h2>
          <p class="muted intro">Each claim has an ID so responses stay attached to the right idea.</p>
          <ol class="claims">
            {d.claims.map((c) => (
              <li class="claim" id={c.id}>
                <div class="claim-top"><span class="claim-id">{c.id}</span><h3>{c.title}</h3></div>
                <p class="q">{c.question}</p>
                <dl>
                  {c.prediction && <div><dt>Prediction</dt><dd>{c.prediction}</dd></div>}
                  {c.falsification && <div><dt>Falsified if</dt><dd>{c.falsification}</dd></div>}
                </dl>
                <a class="textlink small" href={contributeUrl(post.id, c.id)}>Respond to {c.id}{byClaim(c.id) ? ` · ${byClaim(c.id)} so far` : ""}</a>
              </li>
            ))}
          </ol>
        </section>
      )}

      {d.notClaimed.length > 0 && (
        <section id="not-claimed" class="block">
          <h2>What this post does not claim</h2>
          <ul class="notclaimed">{d.notClaimed.map((x) => <li>{x}</li>)}</ul>
        </section>
      )}

      {d.references.length > 0 && (
        <section id="references" class="block">
          <h2>References</h2>
          <ol class="refs">
            {d.references.map((r) => (
              <li>{r.text}{r.url && <> <a href={r.url}>{r.label || r.url}</a></>}</li>
            ))}
          </ol>
        </section>
      )}

      <section id="contributions" class="block">
        <h2>Discussion</h2>
        <p class="muted intro">Thoughts, sources and disagreements are welcome from people and AI alike. Contributions are submitted on GitHub and appear here once reviewed; AI contributions name the model that wrote them.</p>
        {contribs.length === 0 ? (
          <p class="empty">Nothing added yet. <a class="textlink" href={contributeUrl(post.id)}>Add a thought</a></p>
        ) : (
          <>
            <div class="list">{contribs.map((c) => <Contribution c={c} />)}</div>
            <p><a class="textlink" href={contributeUrl(post.id)}>Add a thought</a></p>
          </>
        )}
      </section>

      <footer class="post-foot muted">
        {d.disclaimer && <p><strong>Disclaimer:</strong> {d.disclaimer}</p>}
        <p><a href={link(`/posts/${post.id}.json`)}>Machine-readable version</a></p>
      </footer>
    </article>

    <aside class="toc" aria-label="On this page">
      <p class="toc-title">On this page</p>
      <ol>{toc.map((t) => <li><a href={`#${t.id}`} data-toc={t.id}>{t.text}</a></li>)}</ol>
    </aside>
  </div>
</Base>

<style>
  /* Two-column structure: reading column + sticky contents on wide screens */
  .layout {
    max-width: 1120px; margin: 0 auto;
    padding-left: max(20px, env(safe-area-inset-left, 0px));
    padding-right: max(20px, env(safe-area-inset-right, 0px));
    display: grid; grid-template-columns: minmax(0, 700px) 220px; gap: 0 72px; justify-content: center;
  }
  .layout > :first-child { min-width: 0; }

  .head-band { position: relative; overflow: hidden; border-bottom: 1px solid var(--line); }
  .head-band :global(canvas.cells) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .post-head { position: relative; display: grid; gap: 18px; padding-block: 64px 52px; }
  .head-band.art .status { background: color-mix(in srgb, var(--tint) 88%, transparent); backdrop-filter: blur(6px); }
  .post-head h1 { font-family: var(--f-serif); font-weight: 500; font-size: clamp(2.3rem, 7vw, 4rem); letter-spacing: -0.03em; line-height: 1.02; }
  .sub { font-size: 1.2rem; color: var(--muted); line-height: 1.5; }
  .status { font-size: 0.92rem; color: var(--muted); padding: 14px 16px; background: var(--tint); border-radius: 4px; }
  .status strong { color: var(--ink); font-weight: 600; }

  .body { padding-top: 56px; }
  .post { min-width: 0; }

  /* Contents */
  .toc { position: sticky; top: 32px; align-self: start; max-height: calc(100vh - 64px); overflow-y: auto; padding-top: 4px; }
  .toc-title, .toc-mobile summary { font-family: var(--f-mono); font-size: 0.7rem; font-weight: 500; letter-spacing: 0.05em; text-transform: uppercase; color: var(--ink); }
  .toc ol, .toc-mobile ol { list-style: none; margin: 14px 0 0; padding: 0; display: grid; gap: 2px; border-left: 1px solid var(--line); }
  .toc a, .toc-mobile a { display: block; padding: 5px 0 5px 14px; margin-left: -1px; border-left: 2px solid transparent; font-size: 0.88rem; line-height: 1.4; color: var(--muted); text-decoration: none; }
  .toc a:hover, .toc-mobile a:hover { color: var(--ink); }
  .toc a.active { color: var(--ink); border-left-color: var(--accent); font-weight: 500; }
  .toc-mobile { display: none; margin-bottom: 40px; border: 1px solid var(--line); border-radius: 6px; padding: 14px 16px; }
  .toc-mobile summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; }
  .toc-mobile summary::after { content: "+"; font-weight: 400; font-size: 1.1rem; line-height: 1; color: var(--muted); }
  .toc-mobile[open] summary::after { content: "–"; }
  .toc-mobile summary::-webkit-details-marker { display: none; }

  /* Sections after the article body */
  .block { margin-top: 72px; padding-top: 48px; border-top: 1px solid var(--line); display: grid; gap: 14px; scroll-margin-top: 24px; }
  .block > h2 { font-family: var(--f-serif); font-weight: 500; font-size: 1.9rem; letter-spacing: -0.02em; line-height: 1.15; }
  .intro { font-size: 0.95rem; }

  /* Claims grid */
  .claims { list-style: none; margin: 14px 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .claim { background: var(--paper); border: 1px solid var(--line); border-radius: 2px; padding: 20px; display: grid; gap: 12px; align-content: start; scroll-margin-top: 24px; transition: border-color .15s; }
  .claim:target, .claim:hover { border-color: var(--faint); }
  .claim-top { display: flex; align-items: baseline; gap: 10px; }
  .claim-id { font-weight: 600; font-size: 0.85rem; color: var(--accent); font-variant-numeric: tabular-nums; }
  .claim h3 { font-size: 1rem; letter-spacing: -0.01em; }
  .claim .q { font-size: 0.93rem; line-height: 1.6; }
  .claim dl { margin: 0; display: grid; gap: 10px; padding-top: 12px; border-top: 1px solid var(--line); }
  .claim dl div { display: grid; gap: 2px; }
  .claim dt { font-family: var(--f-mono); font-size: 0.66rem; font-weight: 500; letter-spacing: 0.05em; text-transform: uppercase; color: var(--muted); }
  .claim dd { margin: 0; font-size: 0.9rem; line-height: 1.55; }
  .small { font-size: 0.88rem; margin-top: auto; }

  .notclaimed { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 24px; }
  .notclaimed li { padding: 12px 0; border-bottom: 1px solid var(--line); color: var(--muted); font-size: 0.95rem; }

  .refs { margin: 0; padding-left: 1.4em; display: grid; gap: 10px; font-size: 0.9rem; color: var(--muted); }
  .refs li::marker { color: var(--faint); font-variant-numeric: tabular-nums; }
  .refs a { overflow-wrap: anywhere; }
  .list { display: grid; }
  .empty { color: var(--muted); }

  .post-foot { margin-top: 72px; padding-top: 24px; border-top: 1px solid var(--line); display: grid; gap: 8px; font-size: 0.87rem; }
  .post-foot strong { color: var(--ink); font-weight: 600; }

  @media (max-width: 1080px) {
    .layout { grid-template-columns: minmax(0, 700px); }
    .toc { display: none; }
    .toc-mobile { display: block; }
  }
  @media (max-width: 640px) {
    .post-head { padding-block: 40px 40px; }
    .body { padding-top: 32px; }
    .claims, .notclaimed { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Highlight the section being read in the contents sidebar
  const links = [...document.querySelectorAll(".toc a[data-toc]")];
  const targets = links.map((a) => document.getElementById(a.dataset.toc)).filter(Boolean);
  if ("IntersectionObserver" in window && targets.length) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) links.forEach((a) => a.classList.toggle("active", a.dataset.toc === e.target.id));
      });
    }, { rootMargin: "0px 0px -70% 0px" });
    targets.forEach((t) => io.observe(t));
  }
  document.querySelector(".toc-mobile")?.addEventListener("click", (e) => {
    if (e.target.closest("a")) e.currentTarget.removeAttribute("open");
  });
</script>
