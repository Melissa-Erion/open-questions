---
import { link, abs } from "../../lib/link.mjs";
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Contribution from "../../components/Contribution.astro";
import { contributionsFor, contributeUrl } from "../../lib/contributions.mjs";
import site from "../../site.config.mjs";

export async function getStaticPaths() {
  const posts = await getCollection("posts", (p) => !p.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const d = post.data;
const { Content } = await render(post);
const contribs = await contributionsFor(post.id);
const fmt = (x) => x.toLocaleDateString("en-CA", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
const byClaim = (id) => contribs.filter((c) => c.claim === id).length;
const kindLabel = { hypothesis: "Hypothesis", essay: "Essay", note: "Note", draft: "Draft" }[d.kind];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": d.kind === "hypothesis" ? "ScholarlyArticle" : "BlogPosting",
  headline: d.title,
  alternativeHeadline: d.subtitle,
  description: d.summary,
  datePublished: d.date.toISOString(),
  dateModified: (d.updated || d.date).toISOString(),
  version: d.version,
  author: site.author ? { "@type": "Person", name: site.author } : undefined,
  keywords: d.tags.join(", "),
  url: abs(`/posts/${post.id}/`),
  isAccessibleForFree: true,
  creativeWorkStatus: d.status,
};
---
<Base title={d.title} description={d.summary} jsonLd={jsonLd} alternateJson={`/posts/${post.id}.json`}>
  <div class:list={["head-band", { art: d.art }]}>
    {d.art === "cells" && <canvas class="cells" aria-hidden="true"></canvas>}
    <header class="wrap post-head">
      <div class="meta"><span>{kindLabel}</span><time datetime={d.date.toISOString()}>{fmt(d.date)}</time><span>Version {d.version}</span></div>
      <h1>{d.title}</h1>
      {d.subtitle && <p class="sub">{d.subtitle}</p>}
      {d.status && <p class="status"><strong>Status:</strong> {d.status}</p>}
    </header>
  </div>
  <article class="wrap post">

    <div class="prose"><Content /></div>

    {d.claims.length > 0 && (
      <section id="claims" class="block">
        <h2>Claims</h2>
        <p class="muted intro">Each claim has an ID so responses stay attached to the right idea.</p>
        <ol class="claims">
          {d.claims.map((c) => (
            <li class="claim" id={c.id}>
              <div class="claim-id">{c.id}</div>
              <div class="claim-body">
                <h3>{c.title}</h3>
                <p>{c.question}</p>
                {c.prediction && <p class="pf"><span>Prediction</span>{c.prediction}</p>}
                {c.falsification && <p class="pf"><span>Falsified if</span>{c.falsification}</p>}
                <a class="textlink small" href={contributeUrl(post.id, c.id)}>Respond to {c.id}{byClaim(c.id) ? ` · ${byClaim(c.id)} so far` : ""}</a>
              </div>
            </li>
          ))}
        </ol>
      </section>
    )}

    {d.notClaimed.length > 0 && (
      <section class="block">
        <h2>What this post does not claim</h2>
        <ul class="notclaimed">{d.notClaimed.map((x) => <li>{x}</li>)}</ul>
      </section>
    )}

    <section id="contributions" class="block">
      <h2>Discussion</h2>
      <p class="muted intro">Thoughts, sources and disagreements are welcome from people and AI alike. Contributions are submitted on GitHub and appear here once reviewed; AI contributions name the model that wrote them.</p>
      {contribs.length === 0 ? (
        <p class="empty">Nothing added yet. <a class="textlink" href={contributeUrl(post.id)}>Add a thought</a></p>
      ) : (
        <>
          <div class="list">{contribs.map((c) => <Contribution c={c} />)}</div>
          <p><a class="textlink" href={contributeUrl(post.id)}>Add a thought</a></p>
        </>
      )}
    </section>

    <footer class="post-foot muted">
      {d.disclaimer && <p><strong>Disclaimer:</strong> {d.disclaimer}</p>}
      <p><a href={link(`/posts/${post.id}.json`)}>Machine-readable version</a></p>
    </footer>
  </article>
</Base>

<style>
  .head-band { position: relative; overflow: hidden; }
  .head-band.art { border-bottom: 1px solid var(--line); margin-bottom: 48px; }
  .cells { position: absolute; inset: 0; width: 100%; height: 100%; }
  .post-head { position: relative; display: grid; gap: 18px; padding-top: 64px; padding-bottom: 48px; }
  .head-band.art .post-head { padding-bottom: 56px; }
  .head-band.art .status { background: color-mix(in srgb, var(--tint) 88%, transparent); backdrop-filter: blur(6px); }
  .post-head h1 { font-size: clamp(2rem, 6vw, 3rem); letter-spacing: -0.03em; line-height: 1.08; }
  .sub { font-size: 1.2rem; color: var(--muted); line-height: 1.5; }
  .status { font-size: 0.92rem; color: var(--muted); padding: 14px 16px; background: var(--tint); border-radius: 4px; }
  .status strong { color: var(--ink); font-weight: 600; }

  .block { margin-top: 64px; padding-top: 40px; border-top: 1px solid var(--line); display: grid; gap: 14px; }
  .block > h2 { font-size: 1.35rem; }
  .intro { font-size: 0.95rem; }

  .claims { list-style: none; margin: 12px 0 0; padding: 0; display: grid; }
  .claim { display: grid; grid-template-columns: 44px 1fr; gap: 12px; padding-block: 24px; border-top: 1px solid var(--line); scroll-margin-top: 24px; }
  .claim:first-child { border-top: 0; padding-top: 8px; }
  .claim-id { font-weight: 600; color: var(--accent); font-variant-numeric: tabular-nums; padding-top: 1px; }
  .claim-body { min-width: 0; display: grid; gap: 8px; }
  .claim-body h3 { font-size: 1.05rem; }
  .claim-body > p { font-size: 0.97rem; }
  .pf { color: var(--muted); }
  .pf span { color: var(--ink); font-weight: 500; margin-right: 6px; }
  .pf span::after { content: ":"; }
  .small { font-size: 0.9rem; margin-top: 4px; }

  .notclaimed { margin: 0; padding-left: 1.2em; display: grid; gap: 6px; color: var(--muted); }
  .notclaimed li::marker { content: "–  "; color: var(--faint); }

  .list { display: grid; }
  .empty { color: var(--muted); }

  .post-foot { margin-top: 64px; padding-top: 24px; border-top: 1px solid var(--line); display: grid; gap: 8px; font-size: 0.87rem; }
  .post-foot strong { color: var(--ink); font-weight: 600; }

  @media (max-width: 520px) {
    .post-head { padding-top: 40px; }
    .claim { grid-template-columns: 1fr; gap: 6px; }
  }
</style>

<script>
  // Haematoxylin-and-eosin style cell field, densest on the right so the title stays clear
  const canvas = document.querySelector("canvas.cells");
  function draw() {
    if (!canvas) return;
    const r = canvas.getBoundingClientRect(), dpr = window.devicePixelRatio || 1;
    canvas.width = r.width * dpr; canvas.height = r.height * dpr;
    const x = canvas.getContext("2d"); x.scale(dpr, dpr);
    const cs = getComputedStyle(document.documentElement);
    const a = cs.getPropertyValue("--stain-a").trim(), b = cs.getPropertyValue("--stain-b").trim();
    const narrow = r.width < 640;
    let seed = 11; const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
    const n = Math.round((r.width * r.height) / 2200);
    for (let i = 0; i < n; i++) {
      const px = rnd() * r.width, py = rnd() * r.height;
      const w = Math.pow(px / r.width, narrow ? 2.2 : 3);
      if (rnd() > w * 1.15) continue;
      const rad = (narrow ? 5 : 7) + rnd() * (narrow ? 10 : 15);
      const k = narrow ? 0.6 : 1;
      x.globalAlpha = (0.07 + 0.11 * w) * k; x.fillStyle = b;
      x.beginPath(); x.ellipse(px, py, rad * 1.5, rad * 1.15, rnd() * 3, 0, Math.PI * 2); x.fill();
      x.globalAlpha = (0.16 + 0.34 * w) * k; x.fillStyle = a;
      x.beginPath(); x.ellipse(px, py, rad * 0.42, rad * 0.36, rnd() * 3, 0, Math.PI * 2); x.fill();
    }
    x.globalAlpha = 1;
  }
  draw();
  let t; addEventListener("resize", () => { clearTimeout(t); t = setTimeout(draw, 150); });
  matchMedia("(prefers-color-scheme: dark)").addEventListener("change", draw);
</script>
