---
// A line of thought: it wanders, doubles back, throws off dead-end tangents, and ends in a spiral.
// Generated at build time from a fixed seed, so it is the same on every visit.
const { seed = 7 } = Astro.props;
let s = seed;
const rnd = () => ((s = (s * 16807) % 2147483647) / 2147483647);

const W = 1000, H = 760;
const pts = [];
let x = 70, y = 600, ang = -0.55;
pts.push([x, y]);
for (let i = 0; i < 15; i++) {
  // occasional hard turn: a contradiction sends the thought somewhere else
  ang += (rnd() - 0.5) * (rnd() < 0.25 ? 3.2 : 1.3);
  // steer back toward the middle near the edges
  const cx = W * 0.55, cy = H * 0.45;
  const toC = Math.atan2(cy - y, cx - x);
  if (x < 90 || x > W - 120 || y < 90 || y > H - 90) ang = ang * 0.4 + toC * 0.6;
  const len = 70 + rnd() * 70;
  x += Math.cos(ang) * len; y += Math.sin(ang) * len;
  x = Math.min(W - 80, Math.max(60, x)); y = Math.min(H - 60, Math.max(60, y));
  pts.push([x, y]);
}

// Spiral into the rabbit hole at the end
const [ex, ey] = pts[pts.length - 1];
const sc = [Math.min(W - 130, Math.max(130, ex + 40)), Math.min(H - 130, Math.max(130, ey + 10))];
const spiral = [];
for (let t = 0; t <= 1; t += 0.02) {
  const a = t * Math.PI * 6.5 + Math.atan2(ey - sc[1], ex - sc[0]);
  const r = 70 * (1 - t) + 2;
  spiral.push([sc[0] + Math.cos(a) * r, sc[1] + Math.sin(a) * r]);
}

// Smooth Catmull-Rom curve through points
function curve(p) {
  let d = `M${p[0][0].toFixed(1)},${p[0][1].toFixed(1)}`;
  for (let i = 0; i < p.length - 1; i++) {
    const p0 = p[i - 1] || p[i], p1 = p[i], p2 = p[i + 1], p3 = p[i + 2] || p2;
    const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
    const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
    d += ` C${c1[0].toFixed(1)},${c1[1].toFixed(1)} ${c2[0].toFixed(1)},${c2[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`;
  }
  return d;
}
const main = curve([...pts, ...spiral.slice(1)]);

// Tangents: short branches that go nowhere, ending in an open circle
const tangents = [];
[3, 6, 9, 12].forEach((i) => {
  const [px, py] = pts[i], [qx, qy] = pts[i + 1];
  const base = Math.atan2(qy - py, qx - px) + (rnd() < 0.5 ? 1 : -1) * (0.9 + rnd() * 0.6);
  const l = 55 + rnd() * 50;
  const mx = px + Math.cos(base + 0.4) * l * 0.55, my = py + Math.sin(base + 0.4) * l * 0.55;
  const tx = px + Math.cos(base) * l, ty = py + Math.sin(base) * l;
  tangents.push({ d: `M${px.toFixed(1)},${py.toFixed(1)} Q${mx.toFixed(1)},${my.toFixed(1)} ${tx.toFixed(1)},${ty.toFixed(1)}`, end: [tx, ty] });
});

// Marginal notes, placed beside a few turns
const notes = ["why?", "but then —", "that doesn't add up", "what if…"];
const noteAt = [2, 5, 8, 11].map((i, k) => ({ x: pts[i][0] + 14, y: pts[i][1] - 12, t: notes[k] }));
const nodes = pts.filter((_, i) => i % 3 === 0);
---
<svg class="tangle" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid meet" aria-hidden="true">
  <path class="t-main" d={main} pathLength="1" />
  {tangents.map((t, k) => (
    <g class="t-branch" style={`--d:${0.5 + k * 0.35}s`}>
      <path d={t.d} pathLength="1" />
      <circle cx={t.end[0]} cy={t.end[1]} r="4.5" />
    </g>
  ))}
  {nodes.map((n, k) => <circle class="t-node" cx={n[0]} cy={n[1]} r="3.2" style={`--d:${0.2 + k * 0.3}s`} />)}
  {noteAt.map((n, k) => <text class="t-note" x={n.x} y={n.y} style={`--d:${0.6 + k * 0.4}s`}>{n.t}</text>)}
  <circle class="t-hole" cx={sc[0]} cy={sc[1]} r="2.5" />
</svg>

<style>
  .tangle { display: block; width: 100%; height: auto; overflow: visible; }
  .t-main { fill: none; stroke: var(--accent); stroke-width: 1.4; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 0; animation: draw 3.2s cubic-bezier(.6,.1,.3,1) both; vector-effect: non-scaling-stroke; }
  .t-branch path { fill: none; stroke: var(--faint); stroke-width: 1; stroke-dasharray: 1; animation: draw 1.2s ease-out both; animation-delay: var(--d); vector-effect: non-scaling-stroke; }
  .t-branch circle { fill: var(--bg); stroke: var(--faint); stroke-width: 1; animation: fade .6s ease-out both; animation-delay: calc(var(--d) + .9s); vector-effect: non-scaling-stroke; }
  .t-node { fill: var(--accent); animation: fade .5s ease-out both; animation-delay: var(--d); }
  .t-hole { fill: var(--ink); }
  .t-note { font-family: var(--f-mono); font-size: 15px; fill: var(--muted); letter-spacing: .02em; animation: fade .8s ease-out both; animation-delay: var(--d); }
  @keyframes draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes fade { from { opacity: 0; } to { opacity: 1; } }
  @media (max-width: 640px) { .t-note { font-size: 22px; } }
</style>
