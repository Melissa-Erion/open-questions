---
import SafeText from "./SafeText.astro";
import { REVIEW_LABELS } from "../lib/contributions.mjs";
const { c } = Astro.props;
const isAI = c.contributor.startsWith("AI");
const date = new Date(c.created).toLocaleDateString("en-CA", { year: "numeric", month: "short", day: "numeric" });
const conflicting = /conflicting|counterexample|correction/i.test(c.type);
---
<article class="contrib" id={`c${c.number}`}>
  <header>
    <span class:list={["kind", { warn: conflicting }]}>{c.type}</span>
    <span class="chip">{c.claim}</span>
    {c.review.map((l) => <span class:list={["chip", REVIEW_LABELS[l].tone]}>{REVIEW_LABELS[l].text}</span>)}
  </header>
  <div class="body"><SafeText text={c.summary} /></div>
  {c.sources && (
    <div class="field"><span class="label">Sources</span><SafeText text={c.sources} /></div>
  )}
  {c.uncertainty && (
    <div class="field"><span class="label">Uncertainty</span><SafeText text={c.uncertainty} /></div>
  )}
  <footer>
    <span>
      {isAI ? (c.agent ? `${c.agent} · ` : "AI · ") : ""}
      submitted by <a href={`https://github.com/${c.author}`} rel="nofollow ugc noopener">@{c.author}</a> · {date}
      {c.evidence && ` · ${c.evidence}`}
    </span>
    {isAI && <span class:list={["chip", c.contributor.includes("verified by") ? "ok" : "warn"]}>{c.contributor}</span>}
    <a href={c.url}>Discuss #{c.number}{c.comments ? ` (${c.comments})` : ""}</a>
  </footer>
</article>

<style>
  .contrib { background: var(--surface); border: 1px solid var(--line); padding: 20px 22px; display: grid; gap: 14px; }
  header { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .kind { font: 600 0.78rem var(--f-mono); letter-spacing: 0.05em; text-transform: uppercase; color: var(--hema); margin-right: 4px; }
  .kind.warn { color: var(--eosin); }
  .body, .field { display: grid; gap: 10px; min-width: 0; overflow-wrap: anywhere; }
  .field p { font-size: 0.92rem; }
  footer { display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: center; font-size: 0.84rem; color: var(--muted); border-top: 1px dashed var(--line); padding-top: 12px; }
  footer > a { margin-left: auto; }
</style>
