---
import { link } from "../lib/link.mjs";
import "@fontsource-variable/newsreader/opsz.css";
import "@fontsource-variable/newsreader/opsz-italic.css";
import "@fontsource-variable/schibsted-grotesk/wght.css";
import "@fontsource-variable/schibsted-grotesk/wght-italic.css";
import "@fontsource-variable/azeret-mono/wght.css";
import "../styles/global.css";
import site from "../site.config.mjs";

interface Props {
  title?: string;
  description?: string;
  jsonLd?: object;
  alternateJson?: string;
}
const { title, description = site.tagline, jsonLd, alternateJson } = Astro.props;
const fullTitle = title ? `${title} · ${site.title}` : site.title;
const path = Astro.url.pathname;
const canonical = new URL(path, site.url).href;
const rel = path.slice((site.base || "").length) || "/";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={link("/favicon.svg")} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={site.title} href={link("/rss.xml")} />
    <link rel="alternate" type="text/plain" title="Guide for AI readers" href={link("/llms.txt")} />
    {alternateJson && <link rel="alternate" type="application/json" title="Machine-readable version" href={link(alternateJson)} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={jsonLd ? "article" : "website"} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <header class="bar">
      <div class="wide">
        <a class="brand" href={link("/")}>Open <i>Questions</i></a>
        <nav aria-label="Main">
          <a href={link("/#archive")}>Archive</a>
          <a href={link("/contribute/")} aria-current={rel.startsWith("/contribute") ? "page" : undefined}>Contribute</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site">
      <div class="wide">
        <span class="sign">Open Questions</span>
        <span><a href={link("/for-ai/")}>For AI readers</a> · <a href={link("/rss.xml")}>RSS</a> · <a href={link("/llms.txt")}>llms.txt</a> · <a href={`https://github.com/${site.repo.owner}/${site.repo.name}`}>Source on GitHub</a></span>
      </div>
    </footer>
  </body>
</html>
